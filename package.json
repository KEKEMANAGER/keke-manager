{
  "name": "keke-manager-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "icons": "node scripts/generate-store-icons.mjs",
    "legal:sync": "node scripts/sync-legal-docs.mjs",
    "blog:seed": "node scripts/seed-blog-articles.mjs",
    "blog:build": "node scripts/build-blog.mjs",
    "blog": "node scripts/seed-blog-articles.mjs && node scripts/build-blog.mjs",
    "review:apple": "node scripts/create-apple-review-accounts.mjs",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "db:migrations": "node scripts/list-migrations.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:lan": "expo start --web --host lan",
    "build": "node scripts/normalize-expo-env.mjs && node scripts/seed-blog-articles.mjs && node scripts/build-blog.mjs && node scripts/optimize-brand-assets.mjs && node scripts/generate-seo-assets.mjs && node scripts/sync-legal-docs.mjs && expo export -p web --clear && node scripts/fix-cloudflare-assets.mjs && node scripts/copy-public-to-dist.mjs && node scripts/patch-web-html.mjs && node scripts/prerender-seo-routes.mjs && node scripts/verify-dist-assets.mjs && node scripts/report-bundle-size.mjs",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@supabase/supabase-js": "^2.105.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
