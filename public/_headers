# Prevent stale index.html / broken JS cache (Cloudflare Pages)
/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
