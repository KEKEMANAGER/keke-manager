# Static files (before SPA fallback; Cloudflare applies redirects before assets)
/llms.txt         /llms.txt         200
/llms-full.txt    /llms-full.txt    200
/robots.txt       /robots.txt       200
/sitemap.xml      /sitemap.xml      200
/logo.png         /logo.png         200
/logo.webp        /logo.webp        200
/og-image.jpg     /og-image.jpg     200
/favicon.ico      /favicon.ico      200
/blog/rss.xml     /blog/rss.xml     200
/blog/*           /blog/:splat      200
/services/*       /services/:splat  200
/locations/*      /locations/:splat 200
/sign-up/*        /sign-up/:splat   200
/sign-in/*        /sign-in/:splat   200

# Missing build assets must 404 — never serve index.html as JavaScript (MIME error)
/_expo/*          /404.html         404
/assets/*         /404.html         404

# Expo Router SPA (HTML routes only; static files above take precedence when present)
/*                /index.html       200
